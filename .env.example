# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/baz_crypto_tech
REDIS_URL=redis://localhost:6379

# Bot Configuration
BOT_PORT=3001
BOT_LOG_LEVEL=info
BOT_MIN_FUNDING_RATE=0.02
BOT_MAX_POSITION_SIZE=10000
BOT_LEVERAGE=1

# Trading Parameters
TRADING_MIN_PROFIT_PERCENT=0.5
TRADING_EXECUTION_TIMEOUT_MS=1000
TRADING_REBALANCE_INTERVAL_MS=60000

# Dashboard API
DASHBOARD_API_PORT=3002
NEXT_PUBLIC_API_URL=http://localhost:3002

# Environment
NODE_ENV=development
