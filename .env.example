# Binance API Configuration
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TEST_MODE=false

# Database Configuration
DATABASE_URL=postgresql://baz_user:baz_password@postgres:5432/baz_trade_db
REDIS_URL=redis://redis:6379

# Bot Configuration
BOT_INITIAL_BALANCE=1000
BOT_MAX_POSITION_SIZE=100
BOT_LEVERAGE=2
BOT_MIN_PROFIT_PERCENTAGE=0.1
BOT_MAX_PORTFOLIO_HEAT=5000
BOT_SLIPPAGE_TOLERANCE=0.5

# Funding Rate Strategy
FUNDING_RATE_MIN_THRESHOLD=0.05
FUNDING_RATE_MAX_LEVERAGE=3
FUNDING_RATE_CHECK_INTERVAL=60000
FUNDING_RATE_TRADE_WINDOW_MINUTES=10

# Server Configuration
BACKEND_PORT=5000
FRONTEND_PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRY=7d

# Monitoring
SENTRY_DSN=
WEBHOOK_DISCORD_URL=
