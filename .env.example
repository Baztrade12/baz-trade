# Binance API
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_TESTNET=true

# Database
MONGO_URI=mongodb://root:password@localhost:27017/baz-trade?authSource=admin
REDIS_URL=redis://localhost:6379

# Bot Configuration
BOT_ENABLED=true
BOT_MAX_POSITION_SIZE=1000
BOT_RISK_PER_TRADE=0.02
BOT_MIN_FUNDING_RATE_DIFF=0.001
BOT_MAX_POSITIONS=5
BOT_PROFIT_TARGET=0.001

# API Server
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here

# Frontend
REACT_APP_API_URL=http://localhost:5000

# Telegram Alerts (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
